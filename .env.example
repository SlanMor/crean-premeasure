# Copy to .env on the server and fill in. Never commit .env.

SITE_DOMAIN=crean.markgaffney.com

DJANGO_SECRET_KEY=generate-with-openssl-rand-hex-48
DJANGO_ALLOWED_HOSTS=crean.markgaffney.com
DJANGO_DEBUG=0

POSTGRES_DB=premeasure
POSTGRES_USER=premeasure
POSTGRES_PASSWORD=generate-with-openssl-rand-hex-24
DATABASE_URL=postgres://premeasure:SAME_PASSWORD_AS_ABOVE@db:5432/premeasure

REDIS_URL=redis://redis:6379/0

# Email when a batch of drawings is done (optional; leave EMAIL_HOST empty to turn off)
SITE_URL=https://crean.markgaffney.com
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=Crean pre-measure <noreply@markgaffney.com>
